[Unit]
Description=Lanka Talent Insights — Production Docker Compose Service
Documentation=https://github.com/GehanFonseka/R26-IT-082
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/lti/app-v2
EnvironmentFile=-/opt/lti/app-v2/.env
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
