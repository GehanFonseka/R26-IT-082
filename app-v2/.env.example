# ==============================================================================
# Lanka Talent Insights — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and supply your credentials before deploying.
# Never commit real credentials, database passwords, or private keys to Git.
#
# ==============================================================================
# ⚠️ CRITICAL WARNING: STAGING ENVIRONMENT ISOLATION ⚠️
# ==============================================================================
# DO NOT COPY THE PRODUCTION .env FILE INTO STAGING!
#
# Copying production credentials into staging will cause staging containers to
# connect to the live production database, potentially corrupting production data,
# interfering with real recruiter/candidate accounts, and causing token collisions.
#
# For Staging on AWS EC2 alongside Production:
# 1. FRONTEND PORT: Set FRONTEND_PORT=8081 (Production uses port 80).
# 2. DOCKER NETWORK: app-v2 uses isolated host bridge 'lti-v2-network' (auto-configured in docker-compose.yml).
# 3. DATABASE: Create and configure a separate staging MongoDB user and separate databases:
#    - MONGODB_DB_NAME=lanka_talent_staging
#    - INTERVIEW_ANALYSIS_DB_NAME=lanka_talent_analysis_staging
#    - CV_ANALYSIS_DB_NAME=lanka_talent_analysis_staging
# 4. MODEL PATHS: Configure explicit model host paths under /opt/lti/models.
#    Keep the updated 1,471-row attrition dataset separate from the older production dataset.
#    NEVER overwrite or delete the production dataset or model files.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Ports
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=8080

# Nginx host port binding:
# Staging: 8081 (prevents collision with existing production on port 80)
# Production: 80
FRONTEND_PORT=8081

# Docker Network Note:
# In app-v2/docker-compose.yml, the external host bridge network is named 'lti-v2-network'
# (internal Compose reference: 'lti-network') to ensure complete network isolation from v1.

# ------------------------------------------------------------------------------
# Database (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Staging configuration (MUST use dedicated staging credentials and staging DBs):
MONGODB_URI=mongodb+srv://<staging-username>:<staging-password>@<cluster-host>/lanka_talent_staging?retryWrites=true&w=majority
MONGODB_DB_NAME=lanka_talent_staging
INTERVIEW_ANALYSIS_DB_NAME=lanka_talent_analysis_staging
CV_ANALYSIS_DB_NAME=lanka_talent_analysis_staging

# Production reference (DO NOT use in staging):
# MONGODB_URI=mongodb+srv://<prod-username>:<prod-password>@<cluster-host>/lanka_talent?retryWrites=true&w=majority
# MONGODB_DB_NAME=lanka_talent
# INTERVIEW_ANALYSIS_DB_NAME=lanka_talent_analysis
# CV_ANALYSIS_DB_NAME=lanka_talent_analysis

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Set a distinct strong random secret for staging (different from production)
JWT_SECRET=replace-with-a-long-server-only-secret-for-staging
ACCESS_TOKEN_TTL=15m

# ------------------------------------------------------------------------------
# CORS & Reverse Proxy
# ------------------------------------------------------------------------------
# Staging: Include port 8081 in origin if accessing via port 8081
# e.g., http://54.179.93.147:8081 or http://localhost:8081
CORS_ORIGIN=http://54.179.93.147:8081

# Frontend API routing (relative '/api' routes through Nginx reverse proxy)
VITE_API_BASE_URL=/api

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
ROOM_RATE_LIMIT_WINDOW_MS=60000
ROOM_RATE_LIMIT_MAX=1200

# ------------------------------------------------------------------------------
# ML Model Storage Architecture & Volume Paths
# ------------------------------------------------------------------------------
# Model paths can be configured explicitly per service for host deployments.
# If left unset, docker-compose defaults to the local repository paths.
#
# Production / Staging host paths under /opt/lti/models:
CV_MATCHING_MODEL_PATH=/opt/lti/models/cv-matching
ATTRITION_MODEL_PATH=/opt/lti/models/attrition/attrition_risk_catboost_v7_optuna.joblib
# Keep the updated 1,471-row attrition dataset separate from the older production dataset (836 rows).
# Do NOT overwrite /opt/lti/models/attrition/Sri_Lankan_Hiring_Attrition_Dataset.csv
ATTRITION_DATASET_PATH=/opt/lti/models/attrition/Sri_Lankan_Hiring_Attrition_Dataset_v2.csv
EARLY_ATTRITION_MODEL_PATH=/opt/lti/models/early-attrition/model
RESUME_STRENGTH_MODEL_PATH=/opt/lti/models/resume-strength
INTERVIEW_ANSWER_MODEL_PATH=/opt/lti/models/interview-answer
SPEECH_TO_TEXT_MODEL_PATH=/opt/lti/models/speech-to-text
INTERVIEW_ANALYSIS_MODEL_PATH=/opt/lti/models/interview-analysis

# Central fallback directory (used in validation scripts):
MODEL_ROOT=/opt/lti/models

# CV Matching Settings
MATCHING_MODEL_ID=cv-match-browser-local
MATCHING_MODEL_DTYPE=fp32
MATCHING_THRESHOLD=0.4399277865886688

# Speech to Text (Whisper) — 'tiny' is recommended on EC2 to save ~2.6GB RAM
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1

# Interview Analysis (NLI DeBERTa)
INTERVIEW_NLI_MODEL_ID=nli-deberta-v3-xsmall-local
INTERVIEW_NLI_MODEL_DTYPE=q8

# Resume Strength Model
RESUME_STRENGTH_MODEL_DEVICE=cpu
RESUME_STRENGTH_MODEL_MAX_LENGTH=384

# Interview Answer Scorer (V5 + NLI)
INTERVIEW_ANSWER_MODEL_ID=Final_ASAG_Interview_Scorer_V5
INTERVIEW_ANSWER_MODEL_DEVICE=cpu
INTERVIEW_ANSWER_MODEL_MAX_LENGTH=384
INTERVIEW_ANSWER_NLI_MODEL_ID=cross-encoder/nli-deberta-v3-base
LAZY_LOAD_MODEL=false

# Explanation timeouts
MATCH_EXPLANATION_TIMEOUT_MS=30000
ATTRITION_EXPLANATION_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# External AI Services (Gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# WebRTC / Audio-Video Mesh (LiveKit Cloud)
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ------------------------------------------------------------------------------
# Certificate Verification & Vision AI (Optional 'certificate-ai' Profile)
# ------------------------------------------------------------------------------
# Default is 'false' so standard profile runs smoothly without certificate-ai containers
CERTIFICATE_VERIFICATION_ENABLED=false
CERTIFICATE_LOCAL_MODEL_SERVICE_URL=http://certificate-reader-service:4013
CERTIFICATE_LOCAL_MODEL_TIMEOUT_MS=200000
CERTIFICATE_REQUEST_TIMEOUT_MS=250000
CERTIFICATE_MATCH_THRESHOLD=0.9
CERTIFICATE_OCR_CONFIDENCE=0.85
CERTIFICATE_CACHE_TTL_MS=0

# Ollama / Qwen3-VL Configuration (Active when certificate-ai profile is enabled)
OLLAMA_BASE_URL=http://ollama:11434
CERTIFICATE_VISION_MODEL=qwen3-vl:2b
CERTIFICATE_VISION_ENABLED=true
CERTIFICATE_VISION_MAX_SIDE=1024
CERTIFICATE_OCR_DEVICE=cpu
CERTIFICATE_OCR_LANGUAGE=en
CERTIFICATE_MAX_IMAGES=8
CERTIFICATE_MODEL_MAX_JOBS=1
CERTIFICATE_LOCAL_MODEL_TIMEOUT_SECONDS=180
CERTIFICATE_DOWNLOAD_TIMEOUT_MS=20000
CERTIFICATE_MAX_BYTES=12582912
CERTIFICATE_BROWSER_TIMEOUT_MS=60000
CERTIFICATE_BROWSER_MAX_SCREENS=8
CERTIFICATE_BROWSER_MAX_REQUESTS=256
CERTIFICATE_BROWSER_MAX_JOBS=2
