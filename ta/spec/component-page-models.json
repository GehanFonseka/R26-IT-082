{
  "project": {
    "name": "AI Recruitment Intelligence System",
    "stack": {
      "framework": "React",
      "bundler": "Vite",
      "styling": "TailwindCSS",
      "routing": "react-router-dom",
      "icons": "lucide-react",
      "animations": "framer-motion"
    },
    "uiStyle": "minimal",
    "theme": {
      "storageKey": "ari_theme",
      "default": "dark",
      "modes": ["light", "dark"],
      "toggleImplementation": "toggle `dark` class on <html>"
    }
  },
  "components": {
    "ThemeToggleButton": {
      "purpose": "Switch dark/light theme globally",
      "inputs": {
        "mode": { "type": "string", "allowed": ["light", "dark"] }
      },
      "outputs": {
        "onToggle": {
          "type": "event",
          "effects": [
            "flip mode",
            "persist to localStorage(ari_theme)",
            "update html.dark class"
          ]
        }
      }
    },
    "Header": {
      "purpose": "Top navigation with theme toggle",
      "inputs": {
        "brandText": "string",
        "tagline": "string",
        "navLinks": [
          {
            "label": "string",
            "href": "string (anchor)"
          }
        ]
      },
      "outputs": {
        "onNavClick": "anchor scroll"
      }
    },
    "Hero": {
      "purpose": "Landing introduction with two CTAs",
      "inputs": {
        "headline": "string",
        "subheadline": "string",
        "ctaPrimary": { "label": "string", "href": "string" },
        "ctaSecondary": { "label": "string", "href": "string" },
        "visual": {
          "lines": ["string"]
        }
      },
      "outputs": {}
    },
    "FeatureCard": {
      "purpose": "Single module navigation card",
      "inputs": {
        "title": "string",
        "description": "string",
        "to": "string route",
        "icon": "string"
      },
      "outputs": {
        "onOpen": {
          "type": "navigation",
          "to": "route"
        }
      }
    },
    "ModulesGrid": {
      "purpose": "Render 4 module cards",
      "inputs": {
        "title": "string",
        "subtitle": "string",
        "cards": ["FeatureCard props[]"]
      },
      "outputs": {}
    },
    "HowItWorks": {
      "purpose": "Simple step list",
      "inputs": {
        "title": "string",
        "steps": [
          {
            "n": "number",
            "title": "string",
            "text": "string"
          }
        ]
      },
      "outputs": {}
    },
    "AboutProject": {
      "purpose": "Project context",
      "inputs": {
        "title": "string",
        "text": "string"
      },
      "outputs": {}
    },
    "ContactSection": {
      "purpose": "Contact links",
      "inputs": {
        "title": "string",
        "methods": [
          {
            "type": "email|github",
            "label": "string",
            "value": "string"
          }
        ]
      },
      "outputs": {
        "onContactClick": "open mailto or external link"
      }
    },
    "Footer": {
      "purpose": "Bottom links and copyright",
      "inputs": {
        "brandText": "string",
        "links": [
          {
            "label": "string",
            "href": "string"
          }
        ],
        "copyright": "string"
      },
      "outputs": {}
    },
    "MinimalInputCard": {
      "purpose": "Reusable form card",
      "inputs": {
        "title": "string",
        "helperText": "string",
        "fields": [
          {
            "id": "string",
            "label": "string",
            "type": "textarea|text|file|select",
            "placeholder": "string",
            "options": ["string"]
          }
        ],
        "action": {
          "label": "string"
        }
      },
      "outputs": {
        "onSubmit": {
          "type": "event",
          "payload": "object keyed by field ids"
        }
      }
    },
    "MinimalOutputCard": {
      "purpose": "State-based output display",
      "inputs": {
        "title": "string",
        "state": "idle|loading|success|error",
        "data": "object",
        "errorMessage": "string"
      },
      "outputs": {
        "onCopy": "copy output JSON",
        "onExport": "download output JSON"
      }
    },
    "ModulePageLayout": {
      "purpose": "Shared wrapper for module pages",
      "inputs": {
        "title": "string",
        "description": "string",
        "children": "ReactNode"
      },
      "outputs": {
        "backAction": "navigate('/')"
      }
    }
  },
  "pages": {
    "LandingPage": {
      "route": "/",
      "sections": [
        "Header",
        "Hero",
        "ModulesGrid",
        "HowItWorks",
        "AboutProject",
        "ContactSection",
        "Footer"
      ],
      "notes": [
        "No pricing",
        "No login/signin",
        "4 module cards only",
        "Theme toggle shown in header"
      ]
    },
    "ResumeParserPage": {
      "route": "/resume-parser",
      "model": "Resume Parsing / NER",
      "inputs": {
        "required": ["resumeText"],
        "optional": ["resumeFile"]
      },
      "outputs": {
        "structuredProfile": [
          "full_name",
          "email",
          "phone",
          "location",
          "skills[]",
          "education[]",
          "experience[]",
          "certifications[]",
          "source_file"
        ],
        "entities": [
          {
            "text": "string",
            "label": "string",
            "confidence": "number"
          }
        ]
      },
      "ui": ["ModulePageLayout", "MinimalInputCard", "MinimalOutputCard"]
    },
    "CandidateMatchingPage": {
      "route": "/candidate-matching",
      "model": "Candidate Matching / Scoring",
      "inputs": {
        "required": ["jobDescription", "candidateProfiles"],
        "optional": ["weights"]
      },
      "outputs": {
        "rankedCandidates": [
          {
            "candidate_id": "string",
            "overall_score": "number",
            "skill_score": "number",
            "experience_score": "number",
            "education_score": "number",
            "explanation": "string"
          }
        ]
      },
      "ui": ["ModulePageLayout", "MinimalInputCard", "MinimalOutputCard"]
    },
    "CandidateMatchingPage": {
      "route": "/job-candidate-matching",
      "model": "Job-Candidate Matching / Explainable Scoring",
      "inputs": {
        "required": ["sourceText", "targets"],
        "optional": ["mode", "topK"]
      },
      "outputs": {
        "recommendations": [
          {
            "target_id": "string",
            "target_title": "string",
            "score_0_100": "number",
            "matched_terms": ["string"],
            "missing_terms": ["string"],
            "summary": "string"
          }
        ]
      },
      "ui": ["ModulePageLayout", "MinimalInputCard", "MinimalOutputCard"]
    },
    "RecruitmentAnalyticsPage": {
      "route": "/recruitment-analytics",
      "model": "Hiring Risk & Early Attrition Prediction",
      "inputs": {
        "required": ["cv_file"],
        "optional": ["candidate_meta"]
      },
      "outputs": {
        "attritionRiskResponse": {
          "attrition_probability": "number",
          "retention_probability": "number",
          "attrition_risk_score_0_100": "number",
          "predicted_attrition": "0|1",
          "risk_band": "LOW|MEDIUM|HIGH",
          "assumptions_used": "string[]"
        }
      },
      "ui": ["ModulePageLayout", "MinimalInputCard", "MinimalOutputCard"]
    }
  }
}
