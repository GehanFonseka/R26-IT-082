# ==============================================================================
# Lanka Talent Insights — Production Environment Configuration Template
# Copy this file to .env and supply your credentials before deploying.
# Never commit real credentials, database passwords, or private keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Ports
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=8080
FRONTEND_PORT=80

# ------------------------------------------------------------------------------
# Database (MongoDB Atlas)
# ------------------------------------------------------------------------------
MONGODB_URI=MONGODB_URI=mongodb+srv://9898:989898@rp.c1wmqkj.mongodb.net/?appName=RP
MONGODB_DB_NAME=lanka_talent_staging
INTERVIEW_ANALYSIS_DB_NAME=lanka_talent_analysis_staging
CV_ANALYSIS_DB_NAME=lanka_talent_analysis_staging

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# In production, JWT_SECRET must be explicitly set to a strong random secret.
JWT_SECRET=replace-with-a-long-server-only-secret
ACCESS_TOKEN_TTL=15m

# ------------------------------------------------------------------------------
# CORS & Reverse Proxy
# ------------------------------------------------------------------------------
# Set to the public origin(s) of your deployment.
CORS_ORIGIN=http://54.179.93.147

# Frontend API routing (relative '/api' routes through Nginx reverse proxy)
VITE_API_BASE_URL=/api

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
ROOM_RATE_LIMIT_WINDOW_MS=60000
ROOM_RATE_LIMIT_MAX=1200

# ------------------------------------------------------------------------------
# ML Model Storage Architecture
# ------------------------------------------------------------------------------
# Centralized host model directory mounted into containers at runtime:
MODEL_ROOT=/opt/lti/models

# CV Matching
MATCHING_MODEL_ID=cv-match-browser-local
MATCHING_MODEL_DTYPE=fp32
MATCHING_THRESHOLD=0.4399277865886688

# Speech to Text (Whisper) — 'tiny' is recommended on EC2 to save ~2.6GB RAM
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1

# Interview Analysis (NLI DeBERTa)
INTERVIEW_NLI_MODEL_ID=nli-deberta-v3-xsmall-local
INTERVIEW_NLI_MODEL_DTYPE=q8

# Resume Strength Model
RESUME_STRENGTH_MODEL_DEVICE=cpu
RESUME_STRENGTH_MODEL_MAX_LENGTH=384

# Interview Answer Scorer (V5 + NLI)
INTERVIEW_ANSWER_MODEL_ID=Final_ASAG_Interview_Scorer_V5
INTERVIEW_ANSWER_MODEL_DEVICE=cpu
INTERVIEW_ANSWER_MODEL_MAX_LENGTH=384
INTERVIEW_ANSWER_NLI_MODEL_ID=cross-encoder/nli-deberta-v3-base
LAZY_LOAD_MODEL=false

# Attrition Dataset Path (1,471 rows dataset)
ATTRITION_DATASET_PATH=/opt/lti/models/attrition/Sri_Lankan_Hiring_Attrition_Dataset.csv

# Explanation timeouts
MATCH_EXPLANATION_TIMEOUT_MS=30000
ATTRITION_EXPLANATION_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# External AI Services (Gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# WebRTC / Audio-Video Mesh (LiveKit Cloud)
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ------------------------------------------------------------------------------
# Certificate Verification & Vision AI (Optional 'certificate-ai' Profile)
# ------------------------------------------------------------------------------
# Set to 'false' on resource-constrained EC2 hosts (saves ~4GB RAM)
CERTIFICATE_VERIFICATION_ENABLED=false
CERTIFICATE_LOCAL_MODEL_SERVICE_URL=http://certificate-reader-service:4013
CERTIFICATE_LOCAL_MODEL_TIMEOUT_MS=200000
CERTIFICATE_REQUEST_TIMEOUT_MS=250000
CERTIFICATE_MATCH_THRESHOLD=0.9
CERTIFICATE_OCR_CONFIDENCE=0.85
CERTIFICATE_CACHE_TTL_MS=0

# Ollama / Qwen3-VL Configuration (Active when certificate-ai profile is enabled)
OLLAMA_BASE_URL=http://ollama:11434
CERTIFICATE_VISION_MODEL=qwen3-vl:2b
CERTIFICATE_VISION_ENABLED=true
CERTIFICATE_VISION_MAX_SIDE=1024
CERTIFICATE_OCR_DEVICE=cpu
CERTIFICATE_OCR_LANGUAGE=en
CERTIFICATE_MAX_IMAGES=8
CERTIFICATE_MODEL_MAX_JOBS=1
CERTIFICATE_LOCAL_MODEL_TIMEOUT_SECONDS=180
CERTIFICATE_DOWNLOAD_TIMEOUT_MS=20000
CERTIFICATE_MAX_BYTES=12582912
CERTIFICATE_BROWSER_TIMEOUT_MS=60000
CERTIFICATE_BROWSER_MAX_SCREENS=8
CERTIFICATE_BROWSER_MAX_REQUESTS=256
CERTIFICATE_BROWSER_MAX_JOBS=2
