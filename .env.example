# ==============================================================================
# Lanka Talent Insights - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# Never commit real credentials or private keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/lanka_talent?retryWrites=true&w=majority
MONGODB_DB_NAME=lanka_talent
INTERVIEW_ANALYSIS_DB_NAME=lanka_talent_analysis
CV_ANALYSIS_DB_NAME=lanka_talent_analysis

# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
# In production (NODE_ENV=production), JWT_SECRET MUST be set to a strong secret.
JWT_SECRET=replace-with-a-long-server-only-secret
ACCESS_TOKEN_TTL=15m
# Admin registration requires this invite code to prevent unauthorized admin creation
ADMIN_INVITE_CODE=replace-with-a-private-admin-invite

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
# In production, set to your frontend domain (e.g., https://app.example.com or comma-separated list)
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
ROOM_RATE_LIMIT_WINDOW_MS=60000
ROOM_RATE_LIMIT_MAX=1200

# ------------------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------------------
# Base URL for API Gateway accessed by the browser/client (relative '/api' recommended for reverse proxy)
VITE_API_BASE_URL=/api

# ------------------------------------------------------------------------------
# ML Models
# ------------------------------------------------------------------------------
# Base path where model weights/artifacts are stored (host path or mounted volume)
# Production default mount point: /opt/lti/models or ./models
MODEL_ROOT=./models

# CV Matching
MATCHING_MODEL_DIR=backend/services/cv-matching-service/model
MATCHING_MODEL_ID=cv-match-browser-local
MATCHING_MODEL_DTYPE=fp32
MATCHING_THRESHOLD=0.4399277865886688

# Speech to Text (Whisper) - Default: tiny (saves ~2GB RAM vs small.en)
WHISPER_MODEL_SIZE=tiny
WHISPER_MODEL_PATH=backend/services/speech-to-text-service/model/tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1

# Interview Analysis (NLI)
INTERVIEW_NLI_MODEL_DIR=backend/services/interview-analysis-service/model
INTERVIEW_NLI_MODEL_ID=nli-deberta-v3-xsmall-local
INTERVIEW_NLI_MODEL_DTYPE=q8

# Resume Strength
RESUME_STRENGTH_MODEL_MAX_LENGTH=384

# Interview Answer Scorer (V5 + NLI)
INTERVIEW_ANSWER_MODEL_ID=Final_ASAG_Interview_Scorer_V5
INTERVIEW_ANSWER_MODEL_DEVICE=cpu
INTERVIEW_ANSWER_MODEL_MAX_LENGTH=384
INTERVIEW_ANSWER_NLI_MODEL_ID=cross-encoder/nli-deberta-v3-base
# Set LAZY_LOAD_MODEL=true to defer ~2.86GB model loading until first interview scoring request
LAZY_LOAD_MODEL=false

# ------------------------------------------------------------------------------
# AI / Gemini
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# LiveKit
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ------------------------------------------------------------------------------
# Service URLs
# ------------------------------------------------------------------------------
AUTH_SERVICE_URL=http://localhost:3001
CANDIDATE_SERVICE_URL=http://localhost:3002
CV_EXTRACTION_SERVICE_URL=http://localhost:4001
CV_MATCHING_SERVICE_URL=http://localhost:4002
ATTRITION_SERVICE_URL=http://localhost:4003
JOB_SERVICE_URL=http://localhost:4004
SPEECH_TO_TEXT_SERVICE_URL=http://localhost:4005
INTERVIEW_ANALYSIS_SERVICE_URL=http://localhost:4006
CV_PROFILE_ANALYSIS_SERVICE_URL=http://localhost:4007
ATTRITION_MODEL_SERVICE_URL=http://localhost:4008
RESUME_STRENGTH_MODEL_SERVICE_URL=http://localhost:4009
INTERVIEW_ANSWER_MODEL_SERVICE_URL=http://localhost:4010
EARLY_ATTRITION_MODEL_SERVICE_URL=http://localhost:4011
RESUME_EXPLANATION_MODEL_SERVICE_URL=http://localhost:4012
MATCH_EXPLANATION_MODEL_SERVICE_URL=http://localhost:4012
MATCH_EXPLANATION_TIMEOUT_MS=30000
ATTRITION_EXPLANATION_MODEL_SERVICE_URL=http://localhost:4012
ATTRITION_EXPLANATION_TIMEOUT_MS=30000
